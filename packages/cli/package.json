{
  "name": "explodex",
  "version": "0.2.2",
  "description": "Explodex CLI for ChatGPT.app plugin management (Node 22/24).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-dr/explodex.git",
    "directory": "packages/cli"
  },
  "bin": {
    "explodex": "./dist/bin/explodex.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./artifact-schema": {
      "types": "./dist/artifact-schema.d.ts",
      "import": "./dist/artifact-schema.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./host/*": {
      "types": "./dist/host/*.d.ts",
      "import": "./dist/host/*.js"
    },
    "./cdp": {
      "types": "./dist/cdp/index.d.ts",
      "import": "./dist/cdp/index.js"
    },
    "./cdp/*": {
      "types": "./dist/cdp/*.d.ts",
      "import": "./dist/cdp/*.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "import": "./dist/runtime/*.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/dev/index.js"
    },
    "./dev/*": {
      "types": "./dist/dev/*.d.ts",
      "import": "./dist/dev/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "bash ./scripts/run-build.sh",
    "prepack": "bash ./scripts/run-build.sh",
    "test": "bun test test"
  },
  "dependencies": {
    "@explodex/sdk": "1.2.0",
    "acorn": "8.15.0",
    "esbuild": "0.25.12"
  }
}
