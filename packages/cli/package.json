{
  "name": "explodex",
  "version": "0.0.0-migration",
  "private": true,
  "description": "Explodex CLI package (migration in progress). Host foundation modules land in M1.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "exports": {
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./host/*": {
      "types": "./dist/host/*.d.ts",
      "import": "./dist/host/*.js"
    },
    "./cdp": {
      "types": "./dist/cdp/index.d.ts",
      "import": "./dist/cdp/index.js"
    },
    "./cdp/*": {
      "types": "./dist/cdp/*.d.ts",
      "import": "./dist/cdp/*.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "import": "./dist/runtime/*.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/dev/index.js"
    },
    "./dev/*": {
      "types": "./dist/dev/*.d.ts",
      "import": "./dist/dev/*.js"
    }
  },
  "files": [
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "test": "bun test test"
  }
}
