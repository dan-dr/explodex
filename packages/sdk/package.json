{
  "name": "@explodex/sdk",
  "version": "1.2.0",
  "description": "Explodex plugin authoring SDK and generated ChatGPT renderer runtime.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-dr/explodex.git",
    "directory": "packages/sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/public.d.ts",
      "browser": "./dist/runtime/explodex-runtime.iife.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "bash ./scripts/run-build.sh",
    "prepack": "bash ./scripts/run-build.sh",
    "test": "bun test test"
  },
  "sideEffects": [
    "./dist/runtime/explodex-runtime.iife.js"
  ]
}
