{
  "name": "explodex",
  "version": "0.2.2",
  "description": "A plugin SDK for extending the Codex desktop app.",
  "bin": {
    "explodex": "bin/explodex.mjs"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "bin/",
    "lib/",
    "packages/sdk/dist/runtime/explodex-runtime.iife.js",
    "packages/sdk/dist/runtime/explodex-runtime.iife.js.map",
    "plugins/",
    "assets/icon/Explodex.icns",
    "scripts/splash-screen.swift",
    "templates/splash-app/"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "acorn": "8.15.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-dr/explodex.git"
  },
  "homepage": "https://github.com/dan-dr/explodex#readme",
  "bugs": {
    "url": "https://github.com/dan-dr/explodex/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "electron",
    "plugins",
    "macos"
  ],
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "docs:list": "find docs -maxdepth 2 -type f -name '*.md' | sort",
    "inject": "./scripts/launch.sh --inject-only",
    "launch": "./scripts/launch.sh",
    "package": "bun ./scripts/package-app.ts",
    "build:icon": "zsh scripts/build-icon.sh",
    "clean": "zsh scripts/clean.sh",
    "sync": "bun ./scripts/package-app.ts",
    "validate": "./scripts/validate.sh",
    "release:check": "bun ./scripts/release-util.ts check",
    "release:notes": "bun ./scripts/release-util.ts notes",
    "layout:snapshot": "bun ./scripts/cdp-layout-snapshot.ts",
    "react-devtools": "bun ./scripts/cdp-react-devtools.ts",
    "test": "bun test",
    "build:npm": "bash -c 'export PATH=\"${HOME}/.bun/bin:$PATH\"; exec bun ./scripts/build-npm.ts'",
    "checkTs": "bash -c 'export PATH=\"${HOME}/.bun/bin:$PATH\"; exec bun ./node_modules/.bin/tsc -p packages/cli/tsconfig.json && bun ./node_modules/.bin/tsc -p packages/sdk/tsconfig.json'",
    "prepack": "bash -c 'export PATH=\"${HOME}/.bun/bin:$PATH\"; exec bun ./scripts/build-npm.ts'",
    "node:lts-smoke": "node ./scripts/node-lts-smoke.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0"
  }
}
