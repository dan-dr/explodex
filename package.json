{
  "name": "explodex-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Explodex SDK, CLI, and first-party plugin registry workspace.",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/sdk",
    "packages/cli",
    "packages/plugin-registry",
    "packages/plugin-registry/explodex-plugin-*"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "acorn": "8.15.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-dr/explodex.git"
  },
  "homepage": "https://github.com/dan-dr/explodex#readme",
  "bugs": {
    "url": "https://github.com/dan-dr/explodex/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "electron",
    "plugins",
    "macos"
  ],
  "scripts": {
    "dev": "bun ./packages/cli/src/bin/explodex.ts dev ensure",
    "dev:ensure": "bun ./packages/cli/src/bin/explodex.ts --json dev ensure",
    "dev:prove": "bun ./packages/cli/src/bin/explodex.ts --timeout 10m --json dev prove",
    "dev:status": "bun ./packages/cli/src/bin/explodex.ts --json dev status",
    "dev:restart": "bun ./packages/cli/src/bin/explodex.ts --json dev restart",
    "dev:stop": "bun ./packages/cli/src/bin/explodex.ts --json dev stop",
    "docs:list": "find docs -maxdepth 2 -type f -name '*.md' | sort",
    "validate": "./scripts/validate.sh",
    "test": "bun test",
    "build:npm": "bash -c 'export PATH=\"${HOME}/.bun/bin:$PATH\"; exec bun ./scripts/build-npm.ts'",
    "checkTs": "bash -c 'export PATH=\"${HOME}/.bun/bin:$PATH\"; exec bun ./node_modules/.bin/tsc -p packages/cli/tsconfig.json && bun ./node_modules/.bin/tsc -p packages/sdk/tsconfig.json'",
    "node:lts-smoke": "node ./scripts/node-lts-smoke.mjs",
    "registry:generate": "bun run --cwd packages/plugin-registry registry:generate",
    "registry:stage": "bun run --cwd packages/plugin-registry registry:stage",
    "registry:publish": "bun run --cwd packages/plugin-registry registry:publish"
  }
}
